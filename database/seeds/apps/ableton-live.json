      "context": "Arrangement",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+J", "key": "j", "modifiers": ["Ctrl"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+J", "key": "j", "modifiers": ["Cmd"] }] }
      }
    },
    {
      "command": "Rename Track",
      "context": "Arrangement",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+R", "key": "r", "modifiers": ["Ctrl"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+R", "key": "r", "modifiers": ["Cmd"] }] }
      }
    }
  ]
