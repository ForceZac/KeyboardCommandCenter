{
  "name": "@kcc/desktop",
  "version": "0.0.1",
  "private": true,
  "main": ".webpack/main",
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge make",
    "package": "electron-forge package",
    "build:mac": "electron-builder --mac --publish always",
    "build:mac:local": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish always",
    "build:win:local": "electron-builder --win --publish never",
    "build:native": "cd native && npx @napi-rs/cli build --release --js false",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@kcc/core": "*",
    "electron": "^28.0.0",
    "electron-store": "^7.0.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/plugin-webpack": "^7.0.0",
    "@electron/notarize": "^2.3.0",
    "@types/node": "^20.0.0",
    "css-loader": "^6.0.0",
    "electron-builder": "^24.0.0",
    "jsdom": "^29.1.1",
    "node-loader": "^2.0.0",
    "style-loader": "^3.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
