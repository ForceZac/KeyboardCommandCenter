{
  "name": "Steam",
  "slug": "steam",
  "description": "Digital game distribution platform by Valve",
  "category": "gaming",
  "shortcuts": [
    {
      "command": "Open Steam Overlay",
      "context": "In-Game",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Shift+Tab", "key": "Tab", "modifiers": ["Shift"] }] },
        "macos": { "steps": [{ "keyCombo": "Shift+Tab", "key": "Tab", "modifiers": ["Shift"] }] },
        "linux": { "steps": [{ "keyCombo": "Shift+Tab", "key": "Tab", "modifiers": ["Shift"] }] }
      }
    },
    {
      "command": "Take Screenshot",
      "context": "In-Game",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "F12", "key": "F12", "modifiers": [] }] },
        "macos": { "steps": [{ "keyCombo": "F12", "key": "F12", "modifiers": [] }] },
        "linux": { "steps": [{ "keyCombo": "F12", "key": "F12", "modifiers": [] }] }
      }
    },
    {
