        "macos": { "steps": [{ "keyCombo": "Cmd+Z", "key": "z", "modifiers": ["Cmd"] }] }
      }
    },
    {
      "command": "Go to Beginning",
      "context": "Global",
      "bindings": {
        "macos": { "steps": [{ "keyCombo": "Return", "key": "Enter", "modifiers": [] }] }
      }
    },
    {
