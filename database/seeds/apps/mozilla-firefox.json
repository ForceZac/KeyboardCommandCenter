{
  "name": "Mozilla Firefox",
  "slug": "mozilla-firefox",
  "description": "Open-source web browser by Mozilla Foundation",
  "category": "browsers",
  "shortcuts": [
    {
      "command": "New Tab",
      "context": "Global",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+T", "key": "t", "modifiers": ["Ctrl"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+T", "key": "t", "modifiers": ["Cmd"] }] },
        "linux": { "steps": [{ "keyCombo": "Ctrl+T", "key": "t", "modifiers": ["Ctrl"] }] }
      }
    },
    {
      "command": "Private Browsing Window",
      "context": "Global",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+Shift+P", "key": "p", "modifiers": ["Ctrl", "Shift"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+Shift+P", "key": "p", "modifiers": ["Cmd", "Shift"] }] },
        "linux": { "steps": [{ "keyCombo": "Ctrl+Shift+P", "key": "p", "modifiers": ["Ctrl", "Shift"] }] }
      }
    },
    {
      "command": "Open Developer Tools",
      "context": "Global",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "F12", "key": "F12", "modifiers": [] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+Option+I", "key": "i", "modifiers": ["Cmd", "Option"] }] },
        "linux": { "steps": [{ "keyCombo": "F12", "key": "F12", "modifiers": [] }] }
      }
    },
    {
      "command": "Open Web Console",
      "context": "Developer Tools",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+Shift+K", "key": "k", "modifiers": ["Ctrl", "Shift"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+Option+K", "key": "k", "modifiers": ["Cmd", "Option"] }] },
        "linux": { "steps": [{ "keyCombo": "Ctrl+Shift+K", "key": "k", "modifiers": ["Ctrl", "Shift"] }] }
      }
    },
    {
      "command": "Bookmark Page",
      "context": "Global",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+D", "key": "d", "modifiers": ["Ctrl"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+D", "key": "d", "modifiers": ["Cmd"] }] },
        "linux": { "steps": [{ "keyCombo": "Ctrl+D", "key": "d", "modifiers": ["Ctrl"] }] }
      }
    },
    {
      "command": "Reading Mode Toggle",
      "context": "Global",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "F9", "key": "F9", "modifiers": [] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+Option+R", "key": "r", "modifiers": ["Cmd", "Option"] }] },
        "linux": { "steps": [{ "keyCombo": "F9", "key": "F9", "modifiers": [] }] }
      }
    },
    {
      "command": "Focus Address Bar",
      "context": "Global",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+L", "key": "l", "modifiers": ["Ctrl"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+L", "key": "l", "modifiers": ["Cmd"] }] },
        "linux": { "steps": [{ "keyCombo": "Ctrl+L", "key": "l", "modifiers": ["Ctrl"] }] }
      }
    },
    {
      "command": "Restore Closed Tab",
      "context": "Global",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+Shift+T", "key": "t", "modifiers": ["Ctrl", "Shift"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+Shift+T", "key": "t", "modifiers": ["Cmd", "Shift"] }] },
        "linux": { "steps": [{ "keyCombo": "Ctrl+Shift+T", "key": "t", "modifiers": ["Ctrl", "Shift"] }] }
      }
    },
    {
      "command": "Find in Page",
      "context": "Global",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+F", "key": "f", "modifiers": ["Ctrl"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+F", "key": "f", "modifiers": ["Cmd"] }] },
        "linux": { "steps": [{ "keyCombo": "Ctrl+F", "key": "f", "modifiers": ["Ctrl"] }] }
      }
    },
    {
      "command": "Open Library (History/Bookmarks)",
      "context": "Global",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "Ctrl+Shift+H", "key": "h", "modifiers": ["Ctrl", "Shift"] }] },
        "macos": { "steps": [{ "keyCombo": "Cmd+Shift+H", "key": "h", "modifiers": ["Cmd", "Shift"] }] },
        "linux": { "steps": [{ "keyCombo": "Ctrl+Shift+H", "key": "h", "modifiers": ["Ctrl", "Shift"] }] }
      }
    }
  ]
}
