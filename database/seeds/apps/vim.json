      "context": "Normal Mode",
      "bindings": {
        "windows": { "steps": [{ "keyCombo": "G", "key": "g", "modifiers": ["Shift"] }] },
        "macos": { "steps": [{ "keyCombo": "G", "key": "g", "modifiers": ["Shift"] }] },
        "linux": { "steps": [{ "keyCombo": "G", "key": "g", "modifiers": ["Shift"] }] }
      }
    }
  ]
