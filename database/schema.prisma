generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Top-level taxonomy for applications (Creative, Developer Tools, Productivity, etc.)
model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  applications Application[]

  @@map("categories")
}

// OS platform (Windows, macOS, Linux)
model Platform {
  id       String               @id @default(cuid())
  name     String               @unique
  slug     String               @unique
  bindings ShortcutKeyBinding[]

  @@map("platforms")
}

// An application whose shortcuts are cataloged (e.g. VS Code, Figma)
model Application {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  shortcuts   Shortcut[]
  submissions Submission[]

  @@map("applications")
}

// A command within an application (e.g. "Save File", "Toggle Comment")
model Shortcut {
  id            String               @id @default(cuid())
  applicationId String
  application   Application          @relation(fields: [applicationId], references: [id])
  command       String               // human-readable description
  context       String?              // optional scope: "Global", "Editor", "Normal Mode", etc.
  bindings      ShortcutKeyBinding[]
  collections   CollectionShortcut[]
  submissions   Submission[]

  @@map("shortcuts")
}

// One row per shortcut + platform combination
model ShortcutKeyBinding {
  id         String            @id @default(cuid())
  shortcutId String
  shortcut   Shortcut          @relation(fields: [shortcutId], references: [id])
  platformId String
  platform   Platform          @relation(fields: [platformId], references: [id])
  steps      ShortcutKeyStep[]

  @@unique([shortcutId, platformId])
  @@map("shortcut_key_bindings")
}

// One row per key-press step in a binding; supports chords (Ctrl+K → Ctrl+C = 2 steps)
model ShortcutKeyStep {
  id        String             @id @default(cuid())
  bindingId String
  binding   ShortcutKeyBinding @relation(fields: [bindingId], references: [id])
  stepOrder Int                // 1-based; single shortcuts have exactly one step
  keyCombo  String             // display string e.g. "Ctrl+Shift+P"
  key       String             // base key e.g. "p"
  modifiers String[]           // normalized modifier names e.g. ["Ctrl", "Shift"]

  @@unique([bindingId, stepOrder])
  @@map("shortcut_key_steps")
}

// ─── Auth.js v5 standard models ──────────────────────────────────────────────
// Required by @auth/prisma-adapter. JWT strategy is used so Session rows are
// never written at runtime; the table is present for adapter compatibility only.

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean      @default(false)
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[]
  collections   Collection[]
  submissions   Submission[]

  @@map("users")
}

// A named group of shortcuts saved by a user. One collection per user is
// flagged isDefault=true ("My Favorites") and is auto-created on sign-up.
model Collection {
  id          String              @id @default(cuid())
  userId      String
  name        String
  description String?
  isDefault   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shortcuts   CollectionShortcut[]

  @@map("collections")
}

// Join table linking a shortcut to a collection. userId is denormalized for
// efficient per-user queries without joining through Collection.
model CollectionShortcut {
  id           String     @id @default(cuid())
  userId       String
  collectionId String
  shortcutId   String
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  shortcut     Shortcut   @relation(fields: [shortcutId], references: [id], onDelete: Cascade)

  @@unique([collectionId, shortcutId])
  @@map("collection_shortcuts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Community Contributions (Goal 8) ────────────────────────────────────────

enum SubmissionType {
  NEW_SHORTCUT
  CORRECTION
  APP_REQUEST
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// A community-submitted contribution — new shortcut, correction, or app request.
// The `data` JSON field carries the submitted field values (shape varies by type).
// For NEW_SHORTCUT/CORRECTION, appId is required; for APP_REQUEST it is null
// since the requested app doesn't exist in the database yet.
model Submission {
  id            String           @id @default(cuid())
  type          SubmissionType
  status        SubmissionStatus @default(PENDING)
  submitterId   String
  submitter     User             @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  appId         String?
  app           Application?     @relation(fields: [appId], references: [id], onDelete: SetNull)
  // Populated for CORRECTION only — the shortcut being corrected
  shortcutId    String?
  shortcut      Shortcut?        @relation(fields: [shortcutId], references: [id], onDelete: SetNull)
  data          Json             // submitted field values; shape depends on type
  reviewerNotes String?
  reviewedBy    String?          // admin userId
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("submissions")
}
