<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for hardened runtime with JIT (Electron's V8 engine). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for hardened runtime with unsigned executable memory (Electron internals). -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for hardened runtime when loading dylibs not signed by Apple. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Required for electron-updater to download and replace the app binary. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
